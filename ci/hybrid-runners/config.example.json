{
  "mode": "AUTO",
  "poll_seconds": 15,
  "queue_timeout": 120,
  "run_timeout": 2400,
  "health_ttl": 90,
  "trusted_actors": [
    "alexcelovalnikov-cmd"
  ],
  "hosted": {
    "allowed": false,
    "verified_until": 0,
    "probe": {
      "enabled": false,
      "repository": "alexcelovalnikov-cmd/Weather",
      "workflow": "hybrid-hosted-probe.yml",
      "cooldown": 900,
      "ttl": 900
    }
  },
  "repositories": {
    "alexcelovalnikov-cmd/Weather": {
      "enabled": false,
      "workflow": "hybrid-ci.yml",
      "runtime_ref": "hybrid-runtime-v1",
      "runtime_sha": "",
      "branches": [
        "main",
        "stage"
      ],
      "pr_bases": [
        "main"
      ],
      "routes": [
        "local-mac",
        "local-linux",
        "github-linux"
      ],
      "capabilities": [
        "node24"
      ],
      "runner_names": {
        "local-linux": [
          "hybrid-weather-linux"
        ],
        "local-mac": [
          "hybrid-weather-mac"
        ]
      }
    },
    "alexcelovalnikov-cmd/Server-Admin-Controller": {
